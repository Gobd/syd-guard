{
  "version": 1,
  "name": "default",
  "files": [
    {
      "path": ".",
      "recursive": true,
      "access": [
        "read",
        "write",
        "delete"
      ]
    },
    {
      "path": "~/.cache/go-build",
      "recursive": true,
      "access": [
        "read",
        "write"
      ]
    },
    {
      "path": "~/go/pkg/mod",
      "recursive": true,
      "access": [
        "read",
        "write"
      ]
    },
    {
      "path": "~/.npm",
      "recursive": true,
      "access": [
        "read",
        "write"
      ]
    }
  ],
  "network": [
    {
      "host": "proxy.golang.org",
      "port": 443,
      "transport": "tcp"
    },
    {
      "host": "sum.golang.org",
      "port": 443,
      "transport": "tcp"
    },
    {
      "host": "registry.npmjs.org",
      "port": 443,
      "transport": "tcp"
    }
  ]
}
